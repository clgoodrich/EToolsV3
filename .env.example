# Local SQL Server (default — trusted connection, no creds)
ETOOLS_DB__SERVER=CGDESKTOP\SQLEXPRESS
ETOOLS_DB__DATABASE=UTRBDMSNET
ETOOLS_DB__TRUSTED=true

# Optional production override (set ETOOLS_DB__TRUSTED=false to use these)
# ETOOLS_DB__SERVER=oilgas-sql-prod.ogm.utah.gov
# ETOOLS_DB__USER=your-username
# ETOOLS_DB__PASSWORD=your-password

# SQLite reference databases (paths relative to repo root)
ETOOLS_PLATS_DB=data/Board_DB_Plss_Sections.db
ETOOLS_LOCATION_DB=data/location_data.db
ETOOLS_CASING_DB=data/CasingStrength.db

# WCR template + output
ETOOLS_WCR_TEMPLATE=WCR_Empty.xlsm
ETOOLS_OUTPUT_DIR=output

# UI
ETOOLS_PORT=8080
ETOOLS_LOG_LEVEL=INFO

# Local LLM (Ollama) for PDF metadata extraction. Optional.
# Set ETOOLS_LLM__ENABLED=false to disable LLM fallback entirely.
ETOOLS_LLM__ENABLED=true
ETOOLS_LLM__BASE_URL=http://localhost:11434
ETOOLS_LLM__MODEL=qwen3.5:9b
ETOOLS_LLM__VISION_MODEL=qwen3.5:9b
ETOOLS_LLM__TIMEOUT_S=600
